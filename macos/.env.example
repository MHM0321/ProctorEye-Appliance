# Copy this to .env (install/install.bat does this for you automatically).

# Where the vendor's images live.
IMAGE_REGISTRY=ghcr.io/mhm0321
IMAGE_TAG=latest

# Generated automatically by install/install.bat — leave blank, don't fill
# these in by hand.
JWT_SECRET=
INTERNAL_API_SECRET=

# This machine's real, browser-reachable address (a domain or IP), not
# "localhost" unless you're only ever testing on this same machine.
# Example: PUBLIC_API_URL=http://203.0.113.10:4000
PUBLIC_API_URL=http://localhost:4000

# Your OWN exam site's origin — the SDK runs there and calls the API
# directly, so browsers block it without this. Also include this
# appliance's own dashboard address (a common first-run mistake — see
# README.md). Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=

# Ports this machine exposes. Change only if something else already uses them.
API_PORT=4000
DASHBOARD_PORT=8080

# Optional — leave blank unless instructed otherwise by the vendor.
VLM_FALLBACK_URL=
LICENSE_FILE=
