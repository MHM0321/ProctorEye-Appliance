# Copy this to .env (install/install.bat does this for you automatically).

# Where the vendor's images live.
IMAGE_REGISTRY=ghcr.io/mhm0321
IMAGE_TAG=latest

# Generated automatically by install/install.bat — leave blank, don't fill
# these in by hand.
JWT_SECRET=
INTERNAL_API_SECRET=

# This machine's real, browser-reachable address (a domain or IP), not
# "localhost" unless you're only ever testing on this same machine.
# Example: PUBLIC_API_URL=http://203.0.113.10:4000
PUBLIC_API_URL=http://localhost:4000

# Your OWN exam site's origin — the SDK runs there and calls the API
# directly, so browsers block it without this. Also include this
# appliance's own dashboard address (a common first-run mistake — see
# README.md). Comma-separated for more than one.
CORS_ALLOWED_ORIGINS=

# Ports this machine exposes. Change only if something else already uses them.
API_PORT=4000
DASHBOARD_PORT=8080

# Optional — leave blank unless instructed otherwise by the vendor.
VLM_FALLBACK_URL=
LICENSE_FILE=

# --- HTTPS / TLS (optional — see README.md's "HTTPS / TLS" section) ---
# Leave everything below blank if you're only ever testing on THIS SAME
# machine — browsers treat localhost as secure without HTTPS, so nothing
# below is needed for that. It becomes REQUIRED, not optional, the moment
# any candidate connects from a different device: browsers refuse
# webcam/screen-share access on a non-HTTPS origin, with no exception for a
# private IP.

# Turns the caddy service on at all. Blank (the default) = off, nothing
# below matters. Set to "tls" once you're ready.
COMPOSE_PROFILES=

# Your real public hostname, e.g. proctoreye.example.edu. Needs a DNS
# A/AAAA record pointing at this machine before TLS_MODE=letsencrypt will
# work — TLS_MODE=internal needs no DNS at all, just something to put here.
DOMAIN=

# One of: letsencrypt (default — needs a public domain + open ports 80/443),
# custom-cert (bring your own certificate, works fully offline — see
# caddy/Caddyfile.custom-cert), internal (self-signed, fully offline,
# browsers show a one-time trust warning — see caddy/Caddyfile.internal).
# dns-01 also exists but needs extra setup — see
# caddy/Caddyfile.dns-01.example before choosing it.
TLS_MODE=letsencrypt

# Set to "true" ONLY once COMPOSE_PROFILES=tls above is actually active —
# Caddy then sits in front of the api as a reverse proxy, so the api needs
# to trust ITS forwarded headers to see real visitor IPs for rate-limiting.
# Leave false without Caddy running — trusting forwarded headers with
# nothing real in front would let anyone spoof past rate limiting.
TRUST_PROXY=false

# Only read if TLS_MODE=dns-01 with a Cloudflare-enabled Caddy image — see
# caddy/Caddyfile.dns-01.example. Leave blank for every other TLS_MODE.
CLOUDFLARE_API_TOKEN=
